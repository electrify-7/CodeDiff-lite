# Reporting adds plotting to the measured toolchain without replacing its image tag.
ARG BASE_IMAGE=covdiff-lite:testing
FROM ${BASE_IMAGE}
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update -o APT::Update::Error-Mode=any \
    && apt-get install -y --no-install-recommends python3-matplotlib \
    && dpkg-query -W -f='${Package}\t${Version}\n' > /opt/covdiff/packages.tsv \
    && rm -rf /var/lib/apt/lists/*
ENV MPLCONFIGDIR=/tmp/covdiff-matplotlib
